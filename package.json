{
  "name": "glasshouse",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p ${PORT:-3000}",
    "build": "next build",
    "build:landing": "node scripts/build-landing.mjs",
    "start": "next start -p ${PORT:-3000}",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "test": "vitest run tests/unit",
    "test:int": "python3 tests/integration/sandbox.py",
    "test:e2e": "python3 tests/e2e/shots.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "rate-limiter-flexible": "11.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "axe-core": "4.14.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "sharp": "file:./stubs/sharp"
  }
}
