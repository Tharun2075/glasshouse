# Sandbox only. Host is fixed to https://api-m.sandbox.paypal.com in lib/paypal.ts
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Payout receiver (sandbox personal account email)
PAYPAL_PAYOUT_RECEIVER=
# Optional: real Claude extraction. Blank = deterministic mock (labelled MOCK in the UI)
ANTHROPIC_API_KEY=
# Needed when the key is org-wide: sent as the anthropic-workspace-id header on every Claude request (blank = not sent)
ANTHROPIC_WORKSPACE_ID=
# REQUIRED: at least 32 random characters; the app refuses to sign sessions without it.  openssl rand -hex 32
SESSION_SECRET=
# REQUIRED in production: the public URL (PayPal return URLs + redirects use it, never the Host header)
APP_ORIGIN=http://127.0.0.1:3000

# Set to 1 only behind your own reverse proxy that appends the client IP to X-Forwarded-For (rate limit key).
TRUST_PROXY=0
# Single-user demo only: allow `next start` without a proxy (all callers share one 60/min bucket).
# single-user demo; set TRUST_PROXY=1 behind a proxy instead
ALLOW_SHARED_RATE_LIMIT=1
